# SanctiFlow - AI Church Media Operating System
# Copy this file to .env and fill in your API keys

# Gemini API Key (required for AI scripture detection)
# Get yours at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (default: gemini-2.5-pro)
VITE_GEMINI_MODEL=gemini-2.5-pro

# Default Bible Translation
VITE_DEFAULT_TRANSLATION=KJV

# WebSocket Server URL (for multi-device sync, optional)
VITE_WS_SERVER_URL=ws://localhost:8080

# App Mode: 'web' | 'electron'
VITE_APP_MODE=web
